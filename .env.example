## Example environment variables (DO NOT commit real secrets)
# Copy this file to `.env` and fill in real values locally.

# Flask secret key for session signing
FLASK_SECRET_KEY=

# Admin registration code - required to create the first admin account.
# Without this set, admin registration will be disabled.
# Keep this secret and do not share it! Generate a strong random value.
ADMIN_REGISTRATION_CODE=

# Local SQLite filename
MENTALHEALTHWEB_DB=database.db

# API keys - replace with your own in a local .env (do NOT commit)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: model override for OpenAI responses
MENTALHEALTHWEB_OPENAI_MODEL=gpt-3.5-turbo

# Optional email settings for registration and crisis notifications
# Set EMAIL_BACKEND=smtp when using a real SMTP provider.
EMAIL_BACKEND=console
EMAIL_SENDER=
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Timeout (seconds) for SMTP connections. Prevents requests from hanging forever
# when the SMTP server is unreachable.
EMAIL_TIMEOUT=15
# Resend HTTP API key. Render blocks outbound SMTP (ports 25/465/587), so use
# Resend to actually deliver emails from production. Free tier: https://resend.com
RESEND_API_KEY=
# SendGrid API key (free tier, 100 emails/day). No domain needed — verify a
# single sender email (your Gmail) via "Single Sender Verification".
# https://sendgrid.com
SENDGRID_API_KEY=
CRISIS_EMAIL_RECEIVER=

# --- GMAIL API (OAuth2) — INIREREKOMENDA ---
# PINAKAMAGANDANG OPSYON para sa deliverability: ang email ay talagang
# nagmumula sa Gmail account mo, kaya HINDI napupunta sa spam, at gumagamit
# ito ng HTTPS (port 443) kaya HINDI blocked sa Render free tier.
#
# Paano makuha ang mga ito:
#   1. Sa terminal:  python get_gmail_token.py
#   2. Sundin ang mga hakbang sa taas ng file na iyon (Google Cloud Console).
#   3. Ang script ay magbubukas ng browser para mag-authorize ng Gmail.
#   4. Kopyahin ang 4 na value na ipapakita nito sa ibaba.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# Optional: remote database URL (for production)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
