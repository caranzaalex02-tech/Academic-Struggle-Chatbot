## Example environment variables (DO NOT commit real secrets)
# Copy this file to `.env` and fill in real values locally.

# Flask secret key for session signing
FLASK_SECRET_KEY=

# Local SQLite filename
MENTALHEALTHWEB_DB=database.db

# API keys - replace with your own in a local .env (do NOT commit)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: model override for OpenAI responses
MENTALHEALTHWEB_OPENAI_MODEL=gpt-3.5-turbo

# Optional email settings for registration and crisis notifications
# Set EMAIL_BACKEND=smtp when using a real SMTP provider.
EMAIL_BACKEND=console
EMAIL_SENDER=
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Timeout (seconds) for SMTP connections. Prevents requests from hanging forever
# when the SMTP server is unreachable.
EMAIL_TIMEOUT=15
# Resend HTTP API key. Render blocks outbound SMTP (ports 25/465/587), so use
# Resend to actually deliver emails from production. Free tier: https://resend.com
RESEND_API_KEY=
# SendGrid API key (free tier, 100 emails/day). No domain needed — verify a
# single sender email (your Gmail) via "Single Sender Verification".
# https://sendgrid.com
SENDGRID_API_KEY=
CRISIS_EMAIL_RECEIVER=

# Optional: remote database URL (for production)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
